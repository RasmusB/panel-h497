// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * AUO/Topwin H497TLB01 720x1280 AMOLED (RM69052) on Raspberry Pi DSI, with
 * its Synaptics S3402 touch controller (RMI4 over I2C).
 * Requires the panel-h497 kernel module (driver/) and, for touch, the
 * rmi4-psiopi modules (rmi4/), since the Pi kernel has no RMI4 driver.
 *
 * Parameters (defaults match the CM4 carrier board):
 *   dsi0           Use DSI0 instead of DSI1
 *   lanes=<n>      DSI data lanes, 1-4 (default 4; Pi 4B connector: 2)
 *   rotation=<deg> Panel mounting rotation: 0, 90, 180 or 270 (default 270,
 *                  landscape as mounted in the PsioPi)
 *   reset_gpio=<n> RESX GPIO, active low (default 27)
 *   vddi_gpio=<n>  VDDI 1.8 V LDO enable GPIO, active high (default 18)
 *   vdd_gpio=<n>   VDD 3.1 V LDO enable GPIO, active high (default 23)
 *   touch          Touch controller on i2c_csi_dsi (GPIO 44/45) at 0x20,
 *                  TP_INT GPIO 25, TP_RESX GPIO 24 (default on; touch=off
 *                  to leave it out)
 *
 * The touch controller is powered from the panel rails. Its driver keeps
 * both rails enabled while bound, so blanking only resets the panel and the
 * touch stays powered.
 *
 * Example: dtoverlay=panel-h497,lanes=2,rotation=90,reset_gpio=5
 */
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>

/ {
    compatible = "brcm,bcm2711";

    fragment@0 {
        target-path = "/";
        __overlay__ {
            panel_vddi: panel-vddi {
                compatible = "regulator-fixed";
                regulator-name = "panel_vddi";
                regulator-min-microvolt = <1800000>;
                regulator-max-microvolt = <1800000>;
                gpio = <&gpio 18 GPIO_ACTIVE_HIGH>;
                enable-active-high;
            };

            panel_vdd: panel-vdd {
                compatible = "regulator-fixed";
                regulator-name = "panel_vdd";
                regulator-min-microvolt = <3100000>;
                regulator-max-microvolt = <3100000>;
                gpio = <&gpio 23 GPIO_ACTIVE_HIGH>;
                enable-active-high;
                /* VDD must never come up before VDDI, whichever of the
                 * panel and touch drivers enables it first */
                vin-supply = <&panel_vddi>;
            };
        };
    };

    dsi_frag: fragment@1 {
        target = <&dsi1>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            port {
                dsi_out: endpoint {
                    remote-endpoint = <&panel_in>;
                };
            };

            panel: panel@0 {
                compatible = "auo,h497tlb01";
                reg = <0>;
                vddi-supply = <&panel_vddi>;
                vdd-supply = <&panel_vdd>;
                reset-gpios = <&gpio 27 GPIO_ACTIVE_LOW>;
                dsi-lanes = <4>;
                rotation = <270>;

                port {
                    panel_in: endpoint {
                        remote-endpoint = <&dsi_out>;
                    };
                };
            };
        };
    };

    /* Touch: enable the CM4's DSI/CSI I2C bus (i2c0 via the mux) */
    fragment@2 {
        target = <&i2c0if>;
        __overlay__ {
            status = "okay";
        };
    };

    fragment@3 {
        target = <&i2c0mux>;
        __overlay__ {
            status = "okay";
        };
    };

    /* TP_INT has no pull-up on the prototype board: use the Pi's */
    fragment@4 {
        target = <&gpio>;
        __overlay__ {
            touch_pins: touch_pins {
                brcm,pins = <25>;
                brcm,function = <0>;    /* input */
                brcm,pull = <2>;        /* pull-up */
            };
        };
    };

    fragment@5 {
        target = <&i2c_csi_dsi>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";

            touchscreen@20 {
                compatible = "syna,rmi4-i2c";
                reg = <0x20>;
                #address-cells = <1>;
                #size-cells = <0>;
                pinctrl-names = "default";
                pinctrl-0 = <&touch_pins>;
                interrupt-parent = <&gpio>;
                interrupts = <25 8>;    /* IRQ_TYPE_LEVEL_LOW: RMI4 ATTN */
                reset-gpios = <&gpio 24 GPIO_ACTIVE_LOW>;
                vdd-supply = <&panel_vdd>;
                vio-supply = <&panel_vddi>;
                syna,startup-delay-ms = <100>;

                rmi4-f01@1 {
                    reg = <0x1>;
                    syna,nosleep-mode = <1>;
                };

                /* Report landscape coordinates (1280 x 720) matching
                 * rotation=270: raw Y inverted, then X/Y swapped */
                touch_f12: rmi4-f12@12 {
                    reg = <0x12>;
                    touchscreen-inverted-y;
                    touchscreen-swapped-x-y;
                };
            };
        };
    };

    __overrides__ {
        dsi0 = <&dsi_frag>, "target:0=", <&dsi0>;
        lanes = <&panel>, "dsi-lanes:0";
        rotation = <&panel>, "rotation:0";
        reset_gpio = <&panel>, "reset-gpios:4";
        vddi_gpio = <&panel_vddi>, "gpio:4";
        vdd_gpio = <&panel_vdd>, "gpio:4";
        touch = <0>, "=2=3=4=5";
    };
};
